generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @map("_id")
  username   String   @unique
  password   String
  email      String   @unique
  role       String
  first_name String?
  last_name  String?
  tasbeeh    Json?
  bookmarks  Json?
  avatar_url String?
  github_id  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
