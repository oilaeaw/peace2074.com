generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @map("_id")
  username    String   @unique
  password    String
  email       String   @unique
  role        String
  permissions Json?    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("User")
}

model Profile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique
  first_name      String?
  last_name       String?
  avatar_url      String?
  github_id       String?
  bookmarks       Json?    @default("[]")
  settings        Json?    @default("{}")
  tasbeeh_summary Json?    @default("{\"total\":0,\"sessions\":0}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("Profile")
}

model Tasbeeh {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  daily     Json?    @default("[]")
  sessions  Json?    @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("Tasbeeh")
}

model BlogPost {
  id        String   @id @map("_id")
  slug      String   @unique
  title     String
  excerpt   String?
  content   String
  tags      String[]
  date      String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("BlogPost")
}

model DeployLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  version   String
  userId    String
  createdAt DateTime @default(now())

  @@unique([version, userId])
  @@index([version])
  @@index([userId])
  @@map("DeployLike")
}
