generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @map("_id")
  username    String   @unique
  password    String
  email       String   @unique
  role        String
  first_name  String?
  last_name   String?
  tasbeeh     Json?
  bookmarks   Json?
  avatar_url  String?
  github_id   String?
  permissions Json?    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("User")
}

model BlogPost {
  id        String   @id @map("_id")
  slug      String   @unique
  title     String
  excerpt   String?
  content   String
  tags      String[]
  date      String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("BlogPost")
}
