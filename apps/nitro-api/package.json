{
    "name": "nitro-api",
    "version": "3.1.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm exec dotenv -e ../../.env -- pnpm exec nitro dev -p 3000",
        "build": "pnpm exec nitro build",
        "preview": "pnpm exec nitro preview -p 3000",
        "postinstall": "pnpm exec prisma generate --schema ./prisma/schema.prisma",
        "prisma:generate": "pnpm exec prisma generate --schema ./prisma/schema.prisma",
        "prisma:push": "pnpm exec prisma db push --schema ./prisma/schema.prisma",
        "prisma:sync-users": "pnpm exec dotenv -e ../../.env -- node --experimental-strip-types ./scripts/sync-users-to-prisma.ts",
        "prisma:sync-blogs": "pnpm exec dotenv -e ../../.env -- node ./scripts/sync-blogs-to-prisma.mjs",
        "migrate:chat-permissions": "pnpm exec dotenv -e ../../.env -- node --experimental-strip-types ./scripts/migrate-chat-permissions.ts",
        "hash:password": "node --experimental-strip-types ./scripts/hash-password.ts"
    },
    "dependencies": {
        "@playwright/test": "1.44.0",
        "@prisma/client": "^6.19.2",
        "@simplewebauthn/server": "^13.3.0",
        "arctic": "^3.7.0",
        "mongodb": "^7.1.1",
        "nitropack": "^2.9.7",
        "nodemailer": "^6.9.15",
        "openai": "^6.15.0",
        "prisma": "^6.19.2",
        "web-push": "^3.6.7"
    }
}