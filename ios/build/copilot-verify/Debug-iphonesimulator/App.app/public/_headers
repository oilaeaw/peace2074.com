# === ASSET CACHING ===

# Hashed assets - cache forever (content-addressed)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker - always check for updates
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Static HTML - stale-while-revalidate pattern
/index.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Manifest and metadata
/manifest.webmanifest /robots.txt /sitemap.xml /llms.txt
  Cache-Control: public, max-age=86400

# === API CACHING ===

# Quran data - cache for 30 days (static content)
/data/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# API routes - network first with 12 hour cache
/api/*
  Cache-Control: public, max-age=43200, stale-while-revalidate=604800
  X-Robots-Tag: noindex, nofollow, noarchive

/.netlify/*
  X-Robots-Tag: noindex, nofollow, noarchive

# === ASSET TYPES ===

# Images - 60 days
/*.png /*.jpg /*.jpeg /*.gif /*.svg /*.webp
  Cache-Control: public, max-age=5184000, stale-while-revalidate=604800

# Fonts - 90 days
/*.woff /*.woff2 /*.ttf /*.otf
  Cache-Control: public, max-age=7776000, immutable

# === SECURITY HEADERS ===

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
