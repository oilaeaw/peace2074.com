require_relative '../../node_modules/.pnpm/@capacitor+ios@7.5.0_@capacitor+core@7.5.0/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '14.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/.pnpm/@capacitor+ios@7.5.0_@capacitor+core@7.5.0/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/.pnpm/@capacitor+ios@7.5.0_@capacitor+core@7.5.0/node_modules/@capacitor/ios'

end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
  
  # Fix double-quoted imports in CapacitorCordova framework headers
  capacitor_cordova_path = File.expand_path('../../node_modules/.pnpm/@capacitor+ios@7.5.0_@capacitor+core@7.5.0/node_modules/@capacitor/ios/CapacitorCordova/CapacitorCordova/Classes/Public', __dir__)
  
  if Dir.exist?(capacitor_cordova_path)
    Dir.glob("#{capacitor_cordova_path}/*.{h,m}").each do |file_path|
      text = File.read(file_path)
      # Replace double-quoted CDV imports with angle-bracketed ones
      new_contents = text.gsub(/#import "CDV([^"]+)"/, '#import <Cordova/CDV\1>')
      if text != new_contents
        File.write(file_path, new_contents)
        puts "✓ Fixed imports in #{File.basename(file_path)}"
      end
    end
  end
  
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['USE_HEADERMAP'] = 'NO'
    end
  end
end
