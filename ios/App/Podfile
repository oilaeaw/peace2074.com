require_relative '../../node_modules/.pnpm/@capacitor+ios@7.5.0_@capacitor+core@7.5.0/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '16.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => false

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/.pnpm/@capacitor+ios@7.5.0_@capacitor+core@7.5.0/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/.pnpm/@capacitor+ios@7.5.0_@capacitor+core@7.5.0/node_modules/@capacitor/ios'
  pod 'CapacitorFirebaseAnalytics/AnalyticsWithoutAdIdSupport', :path => '../../node_modules/.pnpm/@capacitor-firebase+analytics@7.5.0_@capacitor+core@7.5.0_firebase@11.10.0/node_modules/@capacitor-firebase/analytics'
  pod 'CapacitorApp', :path => '../../node_modules/.pnpm/@capacitor+app@7.1.2_@capacitor+core@7.5.0/node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../node_modules/.pnpm/@capacitor+browser@7.0.5_@capacitor+core@7.5.0/node_modules/@capacitor/browser'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # ── Comprehensive Capacitor/CapacitorCordova framework header fixes ───────────
  # These vendored headers were written for non-framework builds and have three
  # issues that cause Xcode warnings/errors as framework headers:
  #   1. #import "CAP*.h"  -> must be #import <Capacitor/CAP*.h>
  #   2. #import "CDV*.h"  -> must be #import <Cordova/CDV*.h>
  #   3. @import Foo;      -> must be #import <Foo/Foo.h>  (-fmodules discouraged)
  [
    File.expand_path('../../node_modules/.pnpm/@capacitor+ios@*/node_modules/@capacitor/ios/Capacitor/Capacitor/*.h', __dir__),
    File.expand_path('../../node_modules/.pnpm/@capacitor+ios@*/node_modules/@capacitor/ios/CapacitorCordova/CapacitorCordova/Classes/Public/*.h', __dir__),
  ].each do |pattern|
    Dir.glob(pattern).each do |header|
      text = File.read(header)
      patched = text
        .gsub(/#import "(CAP[^"]+\.h)"/, '#import <Capacitor/\1>')
        .gsub(/#import "(CDV[^"]+\.h)"/, '#import <Cordova/\1>')
        .gsub(/@import (\w+);/) { "#import <#{$1}/#{$1}.h>" }
      if patched != text
        File.write(header, patched)
        puts "✓ Fixed framework header: #{File.basename(header)}"
      end
    end
  end

  # Ensure CAPInstanceDescriptor.m has the Cordova import the header no longer provides.
  desc_m = Dir.glob(File.expand_path('../../node_modules/.pnpm/@capacitor+ios@*/node_modules/@capacitor/ios/Capacitor/Capacitor/CAPInstanceDescriptor.m', __dir__)).first
  if desc_m && File.exist?(desc_m)
    text = File.read(desc_m)
    unless text.include?('#import <Cordova/CDVConfigParser.h>')
      text = text.sub(/(#import [^\n]+\n)/, "\\1#import <Cordova/CDVConfigParser.h>\n")
      File.write(desc_m, text)
      puts "✓ Added <Cordova/CDVConfigParser.h> to CAPInstanceDescriptor.m"
    end
  end

  # Fix "Cannot find protocol declaration for 'CDVScreenOrientationDelegate'"
  # CAPBridgeViewController+CDVScreenOrientationDelegate.h references the protocol
  # but omits the import for it. Add the missing #import <Cordova/CDVScreenOrientationDelegate.h>.
  orientation_h = Dir.glob(File.expand_path('../../node_modules/.pnpm/@capacitor+ios@*/node_modules/@capacitor/ios/Capacitor/Capacitor/CAPBridgeViewController+CDVScreenOrientationDelegate.h', __dir__)).first
  if orientation_h && File.exist?(orientation_h)
    text = File.read(orientation_h)
    unless text.include?('CDVScreenOrientationDelegate.h')
      text = text.sub(
        '#import <Capacitor/Capacitor-Swift.h>',
        "#import <Capacitor/Capacitor-Swift.h>\n#import <Cordova/CDVScreenOrientationDelegate.h>"
      )
      File.write(orientation_h, text)
      puts "✓ Fixed CDVScreenOrientationDelegate protocol import"
    end
  end

  # Fix "Class 'AppDelegate' defined without specifying a base class"
  # AppDelegate.h must extend UIResponder<UIApplicationDelegate>, not NSObject.
  appdelegate_h = Dir.glob(File.expand_path('../../node_modules/.pnpm/@capacitor+ios@*/node_modules/@capacitor/ios/CapacitorCordova/CapacitorCordova/Classes/Public/AppDelegate.h', __dir__)).first
  if appdelegate_h && File.exist?(appdelegate_h)
    correct = <<~OBJC
      #import <UIKit/UIKit.h>
      #import <Cordova/CDVViewController.h>

      @interface AppDelegate : UIResponder <UIApplicationDelegate>

      @property (nonatomic, strong) CDVViewController* viewController;

      @end
    OBJC
    unless File.read(appdelegate_h).include?('UIResponder')
      File.write(appdelegate_h, correct)
      puts "✓ Fixed AppDelegate.h base class to UIResponder<UIApplicationDelegate>"
    end
  end

  # Silence WKProcessPool deprecated warning in vendored Cordova header.
  # This warning is emitted from public header declarations on newer SDKs.
  cordova_pool_header = Dir.glob(File.expand_path('../../node_modules/.pnpm/@capacitor+ios@*/node_modules/@capacitor/ios/CapacitorCordova/CapacitorCordova/Classes/Public/CDVWebViewProcessPoolFactory.h', __dir__)).first
  if cordova_pool_header && File.exist?(cordova_pool_header)
    pool_text = File.read(cordova_pool_header)
    unless pool_text.include?('BEGIN PEACE2074 WKProcessPool warning guard')
      pool_text = pool_text.sub(
        '@interface CDVWebViewProcessPoolFactory : NSObject',
        "#pragma clang diagnostic push\n#pragma clang diagnostic ignored \"-Wdeprecated-declarations\"\n// BEGIN PEACE2074 WKProcessPool warning guard\n@interface CDVWebViewProcessPoolFactory : NSObject"
      )
      pool_text = pool_text.sub(
        '@end',
        "@end\n// END PEACE2074 WKProcessPool warning guard\n#pragma clang diagnostic pop"
      )
      File.write(cordova_pool_header, pool_text)
      puts "✓ Patched CDVWebViewProcessPoolFactory.h deprecated warning guard"
    end
  end

  # CapacitorCordova uses APIs that trigger deprecation warnings on newer iOS SDKs
  # (e.g. WKProcessPool in iOS 15+). Keep app builds clean without patching vendored sources.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      # Xcode 16/17 module verification is stricter than many vendored pod
      # headers/module maps (Firebase, GoogleUtilities, PromisesObjC, etc.).
      # Disable VerifyModule for pod frameworks to avoid third-party header
      # validation failures and missing private module map errors.
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      # Keep this explicitly empty instead of deleting it. If removed entirely,
      # Xcode can fall back to its framework-target defaults (`gnu11 gnu++14`)
      # and still invoke modules-verifier for Swift pods like CapacitorApp /
      # CapacitorBrowser.
      config.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS'] = ''
      # Silence "double-quoted include in framework header" for all pod targets.
      # Many vendored pods (PromisesObjC, nanopb, Firebase, etc.) use relative
      # imports internally; this is harmless and already off in their xcconfigs,
      # but a target-level setting reliably wins over the xcconfig base.
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      # Enable Mac Catalyst for all pod targets so the archive succeeds when
      # destination is "My Mac (Mac Catalyst)". Capacitor pods are compiled from
      # source (`:path =>`), so they compile fine once Xcode is told they support it.
      config.build_settings['SUPPORTS_MACCATALYST'] = 'YES'
      # DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER is not supported on resource
      # bundle targets (e.g. _Privacy bundles). Only set it on framework/app targets.
      unless target.name.end_with?('_Privacy', '_Resources')
        config.build_settings['DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER'] = 'YES'
      end
    end

    if target.name == 'FirebaseCoreInternal'
      target.build_configurations.each do |config|
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end

    if target.name == 'PromisesObjC'
      target.headers_build_phase.files.each do |build_file|
        next unless build_file.file_ref
        next unless File.basename(build_file.file_ref.path.to_s) == 'FBLPromisePrivate.h'

        build_file.settings ||= {}
        build_file.settings['ATTRIBUTES'] = ['Project']
        puts '✓ Marked FBLPromisePrivate.h as project-only for PromisesObjC'
      end
    end

    if ['CapacitorApp', 'CapacitorBrowser'].include?(target.name)
      target.build_configurations.each do |config|
        test_framework_search_paths = Array(config.build_settings['TEST_FRAMEWORK_SEARCH_PATHS'] || '$(inherited)')
        [
          '$(CONFIGURATION_BUILD_DIR)',
          '"${PODS_CONFIGURATION_BUILD_DIR}/Capacitor"',
          '"${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova"',
        ].each do |path_entry|
          test_framework_search_paths << path_entry unless test_framework_search_paths.include?(path_entry)
        end
        config.build_settings['TEST_FRAMEWORK_SEARCH_PATHS'] = test_framework_search_paths
      end
    end

    next unless ['CapacitorCordova', 'Capacitor'].include?(target.name)

    target.build_configurations.each do |config|
      config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      cflags = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
      cflags = Array(cflags)
      unless cflags.include?('-Wno-deprecated-declarations')
        cflags << '-Wno-deprecated-declarations'
      end
      config.build_settings['OTHER_CFLAGS'] = cflags
    end
  end

  # Some generated Pods build configurations (notably aggregate/resource bundle
  # configs such as Pods-App, Promises privacy bundles, GoogleUtilities, etc.)
  # can retain Xcode's default module-verifier/header-warning values even when
  # target-level settings are patched above. Stamp every XCBuildConfiguration in
  # Pods.xcodeproj to keep cold builds from re-enabling VerifyModule.
  installer.pods_project.objects.each do |object|
    next unless object.is_a?(Xcodeproj::Project::Object::XCBuildConfiguration)

    object.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    object.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
    object.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS'] = ''
    object.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
  end

  installer.pods_project.save

  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    next unless user_project

    user_project.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      # The user app project still inherits Xcode template defaults unless we
      # override them here too. Without these app-level overrides, Xcode can
      # re-verify imported pod frameworks (PromisesObjC, Firebase, nanopb, ...)
      # and surface the same quoted-include / missing private module map errors
      # even when the Pods project already disables those checks.
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    end

    user_project.native_targets.each do |native_target|
      native_target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      end

      native_target.build_phases.each do |build_phase|
        next unless build_phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
        next unless build_phase.name&.start_with?('[CP]')

        build_phase.always_out_of_date = '0'
      end
    end

    user_project.save
  end

  # Xcodeproj/CocoaPods can still leave generated build configurations with
  # `ENABLE_MODULE_VERIFIER = YES` even after the object-model patches above.
  # When that happens, device builds re-run VerifyModule on vendored pods like
  # PromisesObjC/FBLPromises and surface the same quoted-include/private-module-map
  # diagnostics again. Do a final text-level sweep of the generated project files
  # so the persisted pbxproj matches the intended settings every time.
  [
    File.join(__dir__, 'Pods', 'Pods.xcodeproj', 'project.pbxproj'),
    File.join(__dir__, 'App.xcodeproj', 'project.pbxproj'),
  ].each do |project_file|
    next unless File.exist?(project_file)

    project_text = File.read(project_file)
    verifier_hits = project_text.scan('ENABLE_MODULE_VERIFIER = YES;').size
    quoted_include_hits = project_text.scan('CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES;').size
    standards_hits = project_text.scan(/^\s*MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS = "[^"]*";\n/).size

    patched_project_text = project_text
      .gsub('ENABLE_MODULE_VERIFIER = YES;', 'ENABLE_MODULE_VERIFIER = NO;')
      .gsub('CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES;', 'CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO;')
      .gsub(/^\s*MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS = "[^"]*";\n/, 'MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS = "";\n')

    next if patched_project_text == project_text

    File.write(project_file, patched_project_text)
    puts "✓ Forced verifier/header settings off in #{File.basename(File.dirname(project_file))} (#{verifier_hits} module verifier, #{quoted_include_hits} quoted-include, #{standards_hits} standards-key overrides)"
  end

  capacitor_verifier_xcconfig_paths = [
    File.join(installer.sandbox.root, 'Target Support Files', 'CapacitorApp', 'CapacitorApp.debug.xcconfig'),
    File.join(installer.sandbox.root, 'Target Support Files', 'CapacitorApp', 'CapacitorApp.release.xcconfig'),
    File.join(installer.sandbox.root, 'Target Support Files', 'CapacitorBrowser', 'CapacitorBrowser.debug.xcconfig'),
    File.join(installer.sandbox.root, 'Target Support Files', 'CapacitorBrowser', 'CapacitorBrowser.release.xcconfig'),
  ]
  capacitor_test_framework_search_paths = '$(inherited) $(CONFIGURATION_BUILD_DIR) "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova"'
  capacitor_verifier_xcconfig_paths.each do |xcconfig_path|
    next unless File.exist?(xcconfig_path)

    xcconfig_text = File.read(xcconfig_path)
    patched_xcconfig_text = xcconfig_text
      .gsub(/^ENABLE_MODULE_VERIFIER\s*=.*\n/, '')
      .gsub(/^MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS\s*=.*\n/, '')
      .gsub(/^TEST_FRAMEWORK_SEARCH_PATHS\s*=.*\n/, '')

    patched_xcconfig_text << "\n" unless patched_xcconfig_text.end_with?("\n")
    patched_xcconfig_text << "ENABLE_MODULE_VERIFIER = NO\n"
    patched_xcconfig_text << "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS =\n"
    patched_xcconfig_text << "TEST_FRAMEWORK_SEARCH_PATHS = #{capacitor_test_framework_search_paths}\n"

    next if patched_xcconfig_text == xcconfig_text

    File.write(xcconfig_path, patched_xcconfig_text)
    puts "✓ Patched #{File.basename(xcconfig_path)} for Capacitor module verification"
  end

  # Fix nanopb umbrella header: double-quoted includes must be angle-bracketed in framework headers
  nanopb_dir = File.join(installer.sandbox.root, 'nanopb')
  umbrella = File.join(installer.sandbox.root, 'Target Support Files/nanopb/nanopb-umbrella.h')
  if File.exist?(umbrella)
    File.write(umbrella, File.read(umbrella).gsub(/#import "([^"]+)"/, '#import <nanopb/\1>'))
    puts "✓ Fixed nanopb-umbrella.h angle-bracket imports"
  end
  ['pb_decode.h', 'pb_encode.h', 'pb_common.h'].each do |f|
    path = File.join(nanopb_dir, f)
    next unless File.exist?(path)
    content = File.read(path)
    patched = content.gsub('#include "pb.h"', '#include <nanopb/pb.h>')
    if patched != content
      File.write(path, patched)
      puts "✓ Fixed #{f} angle-bracket include"
    end
  end

  # GoogleUtilities public headers are framework-facing and live under a stable
  # `Public/GoogleUtilities` include path, so framework-style imports are safe
  # during pod compilation and prevent Xcode from re-flagging them as invalid
  # framework headers in clean or indexed builds.
  google_utilities_public_headers = Dir.glob(
    File.join(installer.sandbox.root, 'GoogleUtilities', 'GoogleUtilities', '**', 'Public', 'GoogleUtilities', '*.h')
  )
  google_utilities_patched_headers = 0
  google_utilities_public_headers.each do |header|
    next unless File.exist?(header)

    content = File.read(header)
    patched = content.gsub(/#import "(GUL[^"]+\.h)"/, '#import <GoogleUtilities/\1>')
    next if patched == content

    File.chmod(0644, header) unless File.writable?(header)
    File.write(header, patched)
    google_utilities_patched_headers += 1
  end
  if google_utilities_patched_headers.positive?
    puts "✓ Fixed GoogleUtilities public framework header imports (#{google_utilities_patched_headers} files)"
  end

  google_utilities_umbrella = File.join(installer.sandbox.root, 'Target Support Files', 'GoogleUtilities', 'GoogleUtilities-umbrella.h')
  if File.exist?(google_utilities_umbrella)
    umbrella_content = File.read(google_utilities_umbrella)
    patched_umbrella_content = umbrella_content.gsub(/#import "(GUL[^"]+\.h)"/, '#import <GoogleUtilities/\1>')
    if patched_umbrella_content != umbrella_content
      File.chmod(0644, google_utilities_umbrella) unless File.writable?(google_utilities_umbrella)
      File.write(google_utilities_umbrella, patched_umbrella_content)
      puts '✓ Fixed GoogleUtilities-umbrella.h angle-bracket imports'
    end
  end

  # PromisesObjC/FBLPromises public framework headers should also use
  # framework-style imports. Keeping them quoted triggers Xcode framework-header
  # validation during indexing/VerifyModule, and the pod also incorrectly marks
  # `FBLPromisePrivate.h` as a private installed header even though the app does
  # not need a private submodule for it.
  promises_public_headers = Dir.glob(
    File.join(installer.sandbox.root, 'PromisesObjC', 'Sources', 'FBLPromises', 'include', '*.h')
  )
  promises_patched_headers = 0
  promises_public_headers.each do |header|
    next unless File.exist?(header)

    content = File.read(header)
    patched = content.gsub(/#import "(FBL[^"]+\.h)"/, '#import <FBLPromises/\1>')
    next if patched == content

    File.chmod(0644, header) unless File.writable?(header)
    File.write(header, patched)
    promises_patched_headers += 1
  end
  if promises_patched_headers.positive?
    puts "✓ Fixed PromisesObjC framework header imports (#{promises_patched_headers} headers)"
  end

  promises_umbrella = File.join(installer.sandbox.root, 'Target Support Files', 'PromisesObjC', 'PromisesObjC-umbrella.h')
  if File.exist?(promises_umbrella)
    umbrella_content = File.read(promises_umbrella)
    patched_umbrella_content = umbrella_content.gsub(/#import "(FBL[^"]+\.h)"/, '#import <FBLPromises/\1>')
    if patched_umbrella_content != umbrella_content
      File.chmod(0644, promises_umbrella) unless File.writable?(promises_umbrella)
      File.write(promises_umbrella, patched_umbrella_content)
      puts '✓ Fixed PromisesObjC-umbrella.h angle-bracket imports'
    end
  end

  # FirebaseCore public headers and umbrella also use quoted relative imports.
  firebase_core_public_headers = Dir.glob(
    File.join(installer.sandbox.root, 'FirebaseCore', 'FirebaseCore', 'Sources', 'Public', 'FirebaseCore', '*.h')
  )
  firebase_core_patched_headers = 0
  firebase_core_public_headers.each do |header|
    next unless File.exist?(header)

    content = File.read(header)
    patched = content.gsub(/#import "(FIR[^"]+\.h)"/, '#import <FirebaseCore/\1>')
    next if patched == content

    File.chmod(0644, header) unless File.writable?(header)
    File.write(header, patched)
    firebase_core_patched_headers += 1
  end
  if firebase_core_patched_headers.positive?
    puts "\u2713 Fixed FirebaseCore framework header imports (#{firebase_core_patched_headers} headers)"
  end

  firebase_core_umbrella = File.join(installer.sandbox.root, 'Target Support Files', 'FirebaseCore', 'FirebaseCore-umbrella.h')
  if File.exist?(firebase_core_umbrella)
    umbrella_content = File.read(firebase_core_umbrella)
    patched_umbrella_content = umbrella_content
      .gsub(/#import "(FIR[^"]+\.h)"/, '#import <FirebaseCore/\1>')
      .gsub(/#import "(FirebaseCore\.h)"/, '#import <FirebaseCore/\1>')
    if patched_umbrella_content != umbrella_content
      File.chmod(0644, firebase_core_umbrella) unless File.writable?(firebase_core_umbrella)
      File.write(firebase_core_umbrella, patched_umbrella_content)
      puts '\u2713 Fixed FirebaseCore-umbrella.h angle-bracket imports'
    end
  end

  # FirebaseInstallations public headers also use quoted imports.
  firebase_installations_public_headers = Dir.glob(
    File.join(installer.sandbox.root, 'FirebaseInstallations', 'FirebaseInstallations', 'Source', 'Library', 'Public', 'FirebaseInstallations', '*.h')
  )
  firebase_installations_patched_headers = 0
  firebase_installations_public_headers.each do |header|
    next unless File.exist?(header)

    content = File.read(header)
    patched = content
      .gsub(/#import "(FIR[^"]+\.h)"/, '#import <FirebaseInstallations/\1>')
      .gsub(/#import "(FirebaseInstallations\.h)"/, '#import <FirebaseInstallations/\1>')
    next if patched == content

    File.chmod(0644, header) unless File.writable?(header)
    File.write(header, patched)
    firebase_installations_patched_headers += 1
  end
  if firebase_installations_patched_headers.positive?
    puts "\u2713 Fixed FirebaseInstallations framework header imports (#{firebase_installations_patched_headers} headers)"
  end

  firebase_installations_umbrella = File.join(installer.sandbox.root, 'Target Support Files', 'FirebaseInstallations', 'FirebaseInstallations-umbrella.h')
  if File.exist?(firebase_installations_umbrella)
    umbrella_content = File.read(firebase_installations_umbrella)
    patched_umbrella_content = umbrella_content
      .gsub(/#import "(FIR[^"]+\.h)"/, '#import <FirebaseInstallations/\1>')
      .gsub(/#import "(FirebaseInstallations\.h)"/, '#import <FirebaseInstallations/\1>')
    if patched_umbrella_content != umbrella_content
      File.chmod(0644, firebase_installations_umbrella) unless File.writable?(firebase_installations_umbrella)
      File.write(firebase_installations_umbrella, patched_umbrella_content)
      puts "\u2713 Fixed FirebaseInstallations-umbrella.h angle-bracket imports"
    end
  end

  # PromisesObjC: source headers use relative "FBL*.h" imports — leave them as-is.
  # We disable quoted-include warnings + module verification in both the Pods
  # project and the user app project so Xcode does not re-flag vendored headers
  # while importing built frameworks. Converting to <PromisesObjC/FBL*.h> breaks
  # compilation because the framework does not exist yet when its own sources
  # are being compiled.
end
