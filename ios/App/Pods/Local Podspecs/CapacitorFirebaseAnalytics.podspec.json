{
  "name": "CapacitorFirebaseAnalytics",
  "version": "7.5.0",
  "summary": "Capacitor plugin for Firebase Analytics.",
  "license": "Apache-2.0",
  "homepage": "git+https://github.com/capawesome-team/capacitor-firebase.git",
  "authors": "Robin Genz <mail@robingenz.dev>",
  "source": {
    "git": "git+https://github.com/capawesome-team/capacitor-firebase.git",
    "tag": "7.5.0"
  },
  "source_files": "ios/Plugin/**/*.{swift,h,m,c,cc,mm,cpp}",
  "platforms": {
    "ios": "14.0"
  },
  "dependencies": {
    "Capacitor": []
  },
  "swift_versions": "5.1",
  "static_framework": true,
  "default_subspecs": "Lite",
  "subspecs": [
    {
      "name": "Lite"
    },
    {
      "name": "Analytics",
      "dependencies": {
        "FirebaseAnalytics": [
          "~> 11.7.0"
        ],
        "GoogleAppMeasurementOnDeviceConversion": [
          "~> 11.7.0"
        ]
      }
    },
    {
      "name": "AnalyticsWithoutAdIdSupport",
      "dependencies": {
        "FirebaseAnalytics/WithoutAdIdSupport": [
          "~> 11.7.0"
        ]
      }
    }
  ],
  "swift_version": "5.1"
}
