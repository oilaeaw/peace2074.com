# Devices required by App Store (6.7" and 6.5" are mandatory)
devices([
  "iPhone 16 Pro Max",   # 6.9" — newest required size
  "iPhone 15 Pro Max",   # 6.7" — required
  "iPhone 14 Plus",      # 6.5" equivalent — required
  "iPhone SE (3rd generation)", # 4.7" — optional but good to have
])

languages(["en-US"])

# The scheme to use for building the app
scheme("App")
workspace("App.xcworkspace")

# Where to save screenshots
output_directory("./fastlane/screenshots")

# Clear previous screenshots before taking new ones
clear_previous_screenshots(true)

# Number of retries on failure
number_of_retries(3)

# Stop after first error
stop_after_first_error(false)
