{
  "name": "@waelio/data",
  "version": "1.0.0",
  "description": "Local secure reactive database accessible from a website",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "build": "tsup index.ts server.ts --format cjs,esm --dts",
    "test": "node --test test/"
  },
  "keywords": [
    "database",
    "local",
    "secure",
    "reactive",
    "json",
    "typescript"
  ],
  "author": "waelio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
