{
  "name": "peace2074",
  "version": "0.2.9",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node -e \"const [maj, min, patch] = process.versions.node.split('.') ; if (Number(maj) < 22 || (Number(maj)==22 && Number(min)<12)) { console.error('Node 22.12+ required. Current:', process.versions.node); process.exit(1)}\" && pkill -9 -f 'vite --strictPort' 2>/dev/null; pkill -9 -f 'nitro dev' 2>/dev/null; pkill -9 -f 'concurrently' 2>/dev/null; for port in 4000 3000 3001; do lsof -ti:$port 2>/dev/null | xargs kill -9 2>/dev/null; done; sleep 3",
    "dev": "pnpm predev && concurrently \"pnpm:dev:vite\" \"pnpm:dev:nitro\"",
    "dev:vite": "vite --strictPort",
    "dev:nitro": "dotenv -- pnpm --filter nitro-api dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky",
    "check:locales": "node --experimental-strip-types scripts/check-locales.ts",
    "sync:branding": "node scripts/sync-mobile-branding.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "mobile:sync": "pnpm build && ./node_modules/.bin/cap sync",
    "mobile:android": "pnpm build && ./node_modules/.bin/cap sync android && ./node_modules/.bin/cap open android",
    "mobile:ios": "pnpm sync:branding && pnpm build && ./node_modules/.bin/cap sync ios && ./node_modules/.bin/cap open ios",
    "ios:open": "./node_modules/.bin/cap open ios",
    "ios:sync": "pnpm sync:branding && ./node_modules/.bin/cap sync ios",
    "ios:dev": "pnpm sync:branding && ./node_modules/.bin/cap sync ios && ./node_modules/.bin/cap open ios",
    "ios:build": "pnpm sync:branding && pnpm build && ./node_modules/.bin/cap sync ios && ./node_modules/.bin/cap open ios",
    "demo:datocms": "node --env-file=.env scripts/demo-datocms-cma.mjs",
    "create:datocms:post": "node --env-file=.env scripts/create-datocms-post.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "1.44.0",
    "@quasar/vite-plugin": "^1.0.0",
    "@types/node": "^24.6.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lighthouse": "12",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "unplugin-vue-router": "^0.19.1",
    "vite": "^7.1.11",
    "vite-plugin-pwa": "^1.2.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.0"
  },
  "lint-staged": {
    "src/**/*.{js,vue,html,css}": "prettier --write",
    "src/**/*.{ts,js,vue}": "eslint --fix"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@casl/ability": "^6.7.3",
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@quasar/extras": "^1.17.0",
    "@types/three": "^0.182.0",
    "@vueuse/core": "^13.9.0",
    "@waelio/ustore": "^1.0.8",
    "axios": "^1.12.2",
    "jose": "^6.1.3",
    "mongoose": "^9.0.1",
    "netlify-identity-widget": "^1.9.2",
    "pinia": "^3.0.3",
    "quasar": "^2.12.10",
    "three": "^0.182.0",
    "unstorage": "^1.17.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.5.1",
    "waelio-utils": "^5.0.3",
    "workbox-window": "^7.4.0"
  }
}