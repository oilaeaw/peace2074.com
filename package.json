{
  "name": "peace2074",
  "version": "3.4.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": {
    "name": "Wael Wahbeh",
    "email": "wahbehw@gmmail.com",
    "url": "https://waelio.com"
  },
  "license": "MIT",
  "description": "Peace2074 — Quran recitation, Tasbeeh, and Holy Names for every Muslim",
  "keywords": [
    "quran",
    "quran-recitation",
    "tasbeeh",
    "islamic",
    "muslim",
    "holy-names",
    "asma-allah",
    "dhikr",
    "vue",
    "quasar",
    "pwa",
    "i18n",
    "pinia"
  ],
  "scripts": {
    "predev": "node -e \"const [maj, min, patch] = process.versions.node.split('.') ; if (Number(maj) < 22 || (Number(maj)==22 && Number(min)<12)) { console.error('Node 22.12+ required. Current:', process.versions.node); process.exit(1)}\" && pkill -9 -f 'vite --strictPort' 2>/dev/null; pkill -9 -f 'nitro dev' 2>/dev/null; for port in 4000 3000; do lsof -ti:$port 2>/dev/null | xargs kill -9 2>/dev/null; done; sleep 3; pnpm sync:quran:data",
    "dev": "pnpm predev && concurrently \"pnpm:dev:vite\" \"pnpm:dev:nitro\"",
    "dev:offline": "pnpm dev",
    "dev:ws": "node --experimental-strip-types --env-file=.env src/shared/utils/scripts/socket-server.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/backup-db.sh --restore",
    "dev:vite": "vite --strictPort",
    "dev:nitro": "dotenv -- pnpm --filter nitro-api dev",
    "clean:binaries": "bash scripts/clean-binaries.sh",
    "prebuild": "pnpm sync:quran:data",
    "build": "pnpm build:frontend",
    "build:frontend": "pnpm sync:quran:data && vite build",
    "build:api": "pnpm --filter nitro-api build",
    "build:node-api": "NITRO_PRESET=node_server NITRO_APP_BASE_URL=/api pnpm build:api",
    "build:cf": "pnpm sync:quran:data && vite build && NITRO_PRESET=cloudflare-pages NITRO_APP_BASE_URL=/api pnpm build:api && cp -r dist/. apps/nitro-api/dist/ && pnpm patch:cf:worker",
    "build:cloudflare": "pnpm build:cf",
    "patch:cf:worker": "node --experimental-strip-types scripts/patch-cf-worker.ts",
    "deploy": "pnpm deploy:cf",
    "deploy:cf": "pnpm exec wrangler pages deploy apps/nitro-api/dist --project-name peace2074-com --branch one --commit-dirty=true",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "prepare": "husky",
    "check:locales": "node --experimental-strip-types scripts/check-locales.ts",
    "sync:quran:data": "node --experimental-strip-types scripts/sync-quran-public-data.ts",
    "db:test": "node --experimental-strip-types scripts/test-db-connection.ts",
    "chapters:translate": "node --experimental-strip-types scripts/generate-chapter-translations.ts",
    "login:youtube": "node --experimental-strip-types scripts/login-youtube.ts",
    "upload:youtube": "node --experimental-strip-types scripts/batch-generate-114-surah-videos.ts 1 114",
    "branding:youtube": "node --experimental-strip-types scripts/update-youtube-channel-branding.ts",
    "test:e2e": "playwright test",
    "test:smoke:deployment": "node --experimental-strip-types scripts/smoke-deployment.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "ios:lanes": "cd ios && if bundle exec fastlane --version >/dev/null 2>&1; then bundle exec fastlane lanes; else fastlane lanes; fi",
    "ios:screenshots:generate": "node --experimental-strip-types scripts/generate-ios-store-screenshots.ts",
    "ios:metadata:sync": "node --experimental-strip-types scripts/sync-app-store-metadata.ts",
    "ios:reset:xcode": "node --experimental-strip-types scripts/reset-xcode-build-service.ts",
    "ns:ios": "pnpm --dir ios exec ns run ios",
    "ns:ios:device": "pnpm --dir ios exec ns run ios --device $IOS_DEVICE_ID",
    "ns:ios:xcode": "open ios/platforms/ios/peace2074mobile.xcodeproj",
    "ios:release": "cd ios && if bundle exec fastlane --version >/dev/null 2>&1; then bundle exec fastlane ios release; else fastlane ios release; fi",
    "tvos:release": "cd peace2074-tvOS && if bundle exec fastlane --version >/dev/null 2>&1; then bundle exec fastlane ios release; else fastlane ios release; fi",
    "ios:upload": "pnpm --dir ios exec fastlane ios upload",
    "ios:archive": "xcodebuild -workspace ios/platforms/ios/peace2074mobile.xcworkspace -scheme peace2074mobile -configuration Release -destination 'generic/platform=iOS' -archivePath ios/platforms/ios/build/peace2074mobile.xcarchive archive | xcpretty || xcodebuild -workspace ios/platforms/ios/peace2074mobile.xcworkspace -scheme peace2074mobile -configuration Release -destination 'generic/platform=iOS' -archivePath ios/platforms/ios/build/peace2074mobile.xcarchive archive",
    "demo:datocms": "node --env-file=.env scripts/demo-datocms-cma.mjs",
    "create:datocms:post": "node --env-file=.env scripts/create-datocms-post.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "1.59.1",
    "@quasar/vite-plugin": "^1.0.0",
    "@types/node": "^24.6.2",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-vue": "^6.0.1",
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lighthouse": "12",
    "lint-staged": "^16.2.3",
    "playwright": "1.59.1",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "unplugin-vue-router": "^0.19.1",
    "vite": "^7.1.11",
    "vite-plugin-pwa": "^1.2.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.127.1",
    "ws": "^8.18.3"
  },
  "lint-staged": {
    "src/**/*.{js,vue,html,css}": "prettier --write",
    "src/**/*.{ts,js,vue}": "eslint --fix"
  },
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "@emailjs/browser": "^4.4.1",
    "@fontsource/amiri": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@fontsource/noto-naskh-arabic": "^5.2.11",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@quasar/extras": "^1.17.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@types/three": "^0.182.0",
    "@vueuse/core": "^13.9.0",
    "@waelio/data": "^1.0.7",
    "@waelio/messaging": "^2.3.6",
    "@waelio/realdb": "^0.1.0",
    "@waelio/sync": "^1.0.6",
    "@waelio/ustore": "^2.0.2",
    "@waelio/utils": "^4.1.5",
    "adhan": "^4.4.3",
    "axios": "^1.12.2",
    "firebase": "^11.2.0",
    "jose": "^6.1.3",
    "mongoose": "^9.0.1",
    "pinia": "^3.0.3",
    "quasar": "^2.12.10",
    "three": "^0.182.0",
    "unstorage": "^1.17.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.5.1",
    "waelio-utils": "^5.0.9",
    "workbox-window": "^7.4.0"
  }
}
