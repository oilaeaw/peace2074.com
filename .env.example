
# Core infrastructure
DATABASE_URL="mongodb+srv://<user>:<password>@cluster.example.mongodb.net/api"
# Local MongoDB fallback (auto-used when Atlas is unreachable — offline/disaster mode)
# Run: brew install mongodb-community && brew services start mongodb-community
# Sync data: ./scripts/backup-db.sh && ./scripts/backup-db.sh --restore
DATABASE_URL_LOCAL="mongodb://localhost:27017/peace2074"
JWT_ACCESS_TOKEN_SECRET="change-me-access"
JWT_REFRESH_TOKEN_SECRET="change-me-refresh"

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET="your-random-secret-min-32-chars"
NITRO_AUTH_SECRET="${AUTH_SECRET}"

# Public base URL used for OAuth callback composition
PUBLIC_URL="https://peace2074.com"

# DeepSeek / AI proxy (set to your provider's API endpoint)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://example.com/v1"
NITRO_DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY}"
NITRO_DEEPSEEK_BASE_URL="${DEEPSEEK_BASE_URL}"

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# Optional single-string form (alternative to the 3 vars above)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Netlify webhook secret (for build triggers)
NETLIFY_WEBHOOK_SECRET="your-webhook-secret"

# GitHub OAuth (from https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth (from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="${PUBLIC_URL}/api/auth/google/callback"
NITRO_GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID}"
NITRO_GOOGLE_CLIENT_SECRET="${GOOGLE_CLIENT_SECRET}"
NITRO_GOOGLE_REDIRECT_URI="${GOOGLE_REDIRECT_URI}"

# Apple OAuth / Sign in with Apple (from https://developer.apple.com/account/)
APPLE_CLIENT_ID="com.peace2074.web"
APPLE_TEAM_ID="ABCDE12345"
APPLE_KEY_ID="XYZ9876543"
# Store the .p8 private key with escaped newlines for hosted environments such as Netlify.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_P8_KEY\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI="${PUBLIC_URL}/api/auth/apple/callback"
NITRO_APPLE_CLIENT_ID="${APPLE_CLIENT_ID}"
NITRO_APPLE_TEAM_ID="${APPLE_TEAM_ID}"
NITRO_APPLE_KEY_ID="${APPLE_KEY_ID}"
NITRO_APPLE_PRIVATE_KEY="${APPLE_PRIVATE_KEY}"
NITRO_APPLE_REDIRECT_URI="${APPLE_REDIRECT_URI}"

# App Store Connect API key for fastlane uploads (different from Sign in with Apple above)
APP_STORE_CONNECT_API_KEY_ID="D383SF739"
APP_STORE_CONNECT_API_ISSUER_ID="6053b7fe-68a8-4acb-89be-165aa6465141"
# Option A: point to the downloaded AuthKey_XXXXXX.p8 file
APP_STORE_CONNECT_API_KEY_PATH="/absolute/path/to/AuthKey_D383SF739.p8"
# Option B: paste the .p8 contents with escaped newlines and leave _PATH empty
APP_STORE_CONNECT_API_KEY_CONTENT=""
APP_STORE_CONNECT_API_IN_HOUSE="false"

# SMTP for contact form and auth emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"
CONTACT_TO="your-email@gmail.com"
SMTP_SECURE="false"

# Google Analytics
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Mobile (Capacitor / Xcode Cloud): backend base URL used inside native WebView runtime.
# Apple Xcode Cloud Shared Environment Variables form:
# Name: VITE_NITRO_BASE
# Value: https://peace2074.com/api
# Secret: No
# Keep value redacted: Off
# Create this once and attach it to every relevant workflow that builds or archives the native app.
# Do not set this in Netlify for the web app unless you intentionally want to override same-origin /api routing.
VITE_NITRO_BASE="https://peace2074.com/api"

# Live chat / messaging service (optional override for the Socket.IO endpoint)
VITE_MESSAGING_URL="https://waelio-messagin-live.onrender.com"

# Client/local storage encryption key for core/config helpers (AES-GCM via waelio-utils)
CONF_ENCRYPTION_KEY="change-me-conf-key"

# EmailJS (if using EmailJS instead of SMTP)
EMAILJS_PUBLIC_KEY="emailjs_public"
EMAILJS_PRIVATE_KEY="emailjs_private"
EMAILJS_TEMPLATE_ID="emailjs_template"

# Web Push Notifications (generate with: node scripts/generate-vapid-keys.mjs)
VAPID_PUBLIC_KEY="BKx..."
VAPID_PRIVATE_KEY="_Xm..."
VAPID_SUBJECT="mailto:admin@peace2074.com"
NITRO_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"
NITRO_VAPID_PRIVATE_KEY="${VAPID_PRIVATE_KEY}"
NITRO_VAPID_SUBJECT="${VAPID_SUBJECT}"

# Enable automatic push notifications for blog posts (optional)
ENABLE_BLOG_NOTIFICATIONS="true"

# DatoCMS (optional: blog source)
# Create token in DatoCMS -> Project Settings -> API Tokens
DATOCMS_API_TOKEN="your-datocms-cma-token"
# Model API key used to fetch blog posts from DatoCMS CMA
DATOCMS_BLOG_ITEM_TYPE_API_KEY="blog_post"

