
# Core infrastructure
DATABASE_URL="mongodb+srv://<user>:<password>@cluster.example.mongodb.net/api"
JWT_ACCESS_TOKEN_SECRET="change-me-access"
JWT_REFRESH_TOKEN_SECRET="change-me-refresh"

# DeepSeek / AI proxy (set real values in env/Netlify, leave placeholders here)
DEEPSEEK_API_KEY="<your-deepseek-key>"
DEEPSEEK_BASE_URL="https://your-deepseek-endpoint.example" # set only if you override the default
# Nitro also reads NITRO_DEEPSEEK_API_KEY / NITRO_DEEPSEEK_BASE_URL if provided

# Front-end API uses same-origin by default; set only if overriding
https://api.waelio.com/api/quran="https://api.waelio.com/api/quran"

# GitHub OAuth (if enabled)
GITHUB_CLIENT_ID="gh-oauth-id"
GITHUB_CLIENT_SECRET="gh-oauth-secret"

# Google Analytics
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Client/local storage encryption key for core/config helpers (AES-GCM via waelio-utils)
CONF_ENCRYPTION_KEY="change-me-conf-key"

# EmailJS
EMAILJS_PUBLIC_KEY="emailjs_public"
EMAILJS_PRIVATE_KEY="emailjs_private"
EMAILJS_TEMPLATE_ID="emailjs_template"



