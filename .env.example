
# Core infrastructure
DATABASE_URL="mongodb+srv://<user>:<password>@cluster.example.mongodb.net/api"
JWT_ACCESS_TOKEN_SECRET="change-me-access"
JWT_REFRESH_TOKEN_SECRET="change-me-refresh"

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET="your-random-secret-min-32-chars"
NITRO_AUTH_SECRET="${AUTH_SECRET}"

# DeepSeek / AI proxy (uses https://api.deepseek.com by default)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
NITRO_DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY}"

# Netlify webhook secret (for build triggers)
NETLIFY_WEBHOOK_SECRET="your-webhook-secret"

# GitHub OAuth (from https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# SMTP for contact form and auth emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"
CONTACT_TO="your-email@gmail.com"
SMTP_SECURE="false"

# Google Analytics
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Client/local storage encryption key for core/config helpers (AES-GCM via waelio-utils)
CONF_ENCRYPTION_KEY="change-me-conf-key"

# EmailJS (if using EmailJS instead of SMTP)
EMAILJS_PUBLIC_KEY="emailjs_public"
EMAILJS_PRIVATE_KEY="emailjs_private"
EMAILJS_TEMPLATE_ID="emailjs_template"



