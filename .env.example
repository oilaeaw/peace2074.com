# Example environment variables for local development
# Copy this file to `.env` (or set env vars in your environment) and fill the values.
# Notes:
# - SITE_BASE_URL should be the public base URL where your app is reachable (used to derive callback URLs).
# - You can set explicit callback URLs (GITHUB_CALLBACK_URL, GOOGLE_CALLBACK_URL). If omitted, the server derives them from the incoming request host.

# App / runtime
# Base URL of your local app (used for i18n canonical links and OAuth callbacks)
SITE_BASE_URL=http://localhost:3000
API_BASE_URL=/api

# Database
MONGODB_URI=mongodb://localhost:27017/peace2074
DATABASE_URL=

# Sessions / JWT
NUXT_SESSION_PASSWORD=change_this_session_password
JWT_SECRET=change_this_jwt_secret
NUXT_JWT_ACCESS_TOKEN_SECRET=change_this_access_token_secret

# GitHub OAuth
# Register an OAuth App at: https://github.com/settings/developers
# Set the Authorization callback URL to either:
#   ${SITE_BASE_URL}/api/auth/github/callback
# or set an explicit GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Google OAuth (OAuth 2.0 Client ID)
# Register at: https://console.developers.google.com/apis/credentials
# Set the Authorized redirect URI to either:
#   ${SITE_BASE_URL}/api/auth/google/callback
# or set an explicit GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional: Google JSON credentials can also be provided as a concatenated ENV value
# (some code reads `client_id` / `client_secret` keys from the env). Example variables used
# by nuxt.config.ts: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL

# --------------------------------------------------
# WebSockets — choose ONE mode
# --------------------------------------------------
# Recommended for dev: Nitro-attached Socket.IO on same-origin
NUXT_SOCKET_ATTACH=true
NUXT_PUBLIC_SOCKET_ENABLED=true
NUXT_PUBLIC_SOCKET_URL=
NUXT_PUBLIC_SOCKET_PATH=/_socket.io

# Alternative (opt-in): Standalone Socket.IO dev server
# - Enables ./shared/utils/scripts/socket-server.mjs on SOCKET_PORT
# - Point the client to the standalone URL and default path /socket.io
# WS_STANDALONE=true
# SOCKET_PORT=3001
# NUXT_SOCKET_ATTACH=false
# NUXT_PUBLIC_SOCKET_ENABLED=true
# NUXT_PUBLIC_SOCKET_URL=http://localhost:3001
# NUXT_PUBLIC_SOCKET_PATH=/socket.io
